# Copy this file to ".env" (same folder) and fill it in. Never share or commit .env.

# ---------- eBay SANDBOX keys (developer.ebay.com → Application Keys → Sandbox) ----------
EBAY_SANDBOX_APP_ID=""
EBAY_SANDBOX_DEV_ID=""
EBAY_SANDBOX_CERT_ID=""
# RuName = the "eBay Redirect URL name" from User Tokens → Get a Token from eBay via Your Application
EBAY_SANDBOX_RUNAME=""
# Filled in automatically when you click "Connect eBay" in Settings. Leave blank.
EBAY_SANDBOX_REFRESH_TOKEN=""

# ---------- eBay PRODUCTION keys (developer.ebay.com → Application Keys → Production) ----------
EBAY_PROD_APP_ID=""
EBAY_PROD_DEV_ID=""
EBAY_PROD_CERT_ID=""
EBAY_PROD_RUNAME=""
EBAY_PROD_REFRESH_TOKEN=""

# ---------- Marketplace Account Deletion notifications (needed for production keys) ----------
# A random 32-80 character string (letters, numbers, _ and -). You type the same value on eBay's site.
EBAY_VERIFICATION_TOKEN=""
# The public HTTPS URL that reaches this PC's port 8001, ending in /ebay/account-deletion
EBAY_DELETION_ENDPOINT_URL=""

# ---------- Optional: let Claude write listing titles/descriptions (Settings → Listing defaults) ----------
ANTHROPIC_API_KEY=""

# ---------- Optional overrides ----------
# APP_PORT=8000
# APP_NOTIFY_PORT=8001
