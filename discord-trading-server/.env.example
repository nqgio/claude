# Copy to .env and fill in. Never commit your real .env.

# Discord bot token (Developer Portal -> Your App -> Bot -> Reset Token)
DISCORD_TOKEN=your-bot-token-here

# Your server (guild) ID. Enable Developer Mode in Discord, right-click the
# server icon -> Copy Server ID.
GUILD_ID=000000000000000000

# ----- Whop payment / verification integration (webhook_whop.py) -----
# From Whop dashboard -> Developer -> Webhooks. Used to verify webhook
# authenticity. Leave blank only for local testing.
WHOP_WEBHOOK_SECRET=
# Header Whop signs requests with (override only if your Whop version differs).
WHOP_SIGNATURE_HEADER=X-Whop-Signature

# ----- Optional: Stripe payment integration (webhook_stripe.py) -----
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

PORT=5000
