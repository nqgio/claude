# Copy to .env and fill in. Never commit your real .env.

# Discord bot token (Developer Portal -> Your App -> Bot -> Reset Token)
DISCORD_TOKEN=your-bot-token-here

# Your server (guild) ID. Enable Developer Mode in Discord, right-click the
# server icon -> Copy Server ID.
GUILD_ID=000000000000000000

# ----- Optional: Stripe payment integration (webhook_stripe.py) -----
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PORT=5000
